<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Redirect direct requests for index.html to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[?\s] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 2. 301 Redirect *.html to clean extensionless URLs (excluding actual files needed like sitemap etc if any)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\s]+)\.html[?\s] [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # 3. Internally resolve clean URLs to .html files
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Custom 404 Error Document
ErrorDocument 404 /404.html
